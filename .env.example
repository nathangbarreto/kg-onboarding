# Copie para .env e preencha. O .env não é versionado.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-por-uma-senha-forte
# NEO4J_HEAP=1G                  # padrão 2G; use 1G em máquinas com ~4 GB de RAM

# LLM: com ANTHROPIC_API_KEY definida, usa a API do Claude; senão, o Ollama local.
ANTHROPIC_API_KEY=
# LLM_PROVEDOR=anthropic         # força o provedor: anthropic | ollama
# LLM_MODELO=claude-haiku-5-5    # padrão: claude-haiku-5-5 (anthropic) / qwen2.5:3b (ollama)
# LLM_ESFORCO=low                # anthropic: low | medium | high
# LLM_PENSAR=0                   # 1 liga o raciocínio do Haiku (mais caro)
# LLM_CACHE=1                    # 0 desliga o cache de respostas (data/cache_llm/)

# Só para o Ollama (docker compose --profile ollama up -d)
# OLLAMA_HOST=http://localhost:11434
# LLM_NUM_CTX=8192
